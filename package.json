{
  "name": "time-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @time-tracker/server --filter @time-tracker/web dev",
    "build": "pnpm --filter @time-tracker/web build && pnpm --filter @time-tracker/server build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "deploy": "pnpm build && pnpm --filter @time-tracker/server run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
