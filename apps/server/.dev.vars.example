# Copy to .dev.vars (gitignored) for local development.

# Bearer token the app and Shortcuts send. Required from M2: while it is unset or empty,
# every /api route except /api/health answers 401. Generate: openssl rand -base64 32
AUTH_TOKEN=

# Web Push (VAPID) settings are all optional. Without them the Worker generates a key pair on
# first use, stores it in D1 (server_config) and uses https://<the app's host> as the subject.
# Set both keys only to use a pair of your own (npx web-push generate-vapid-keys). Changing the
# keys later invalidates existing subscriptions; the app re-subscribes on its next launch.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional contact for push services, a mailto: or https: URL, e.g. mailto:you@example.com.
VAPID_SUBJECT=
